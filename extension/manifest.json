{
  "manifest_version": 3,
  "name": "Live Captions → Claude Code (Meet experimental)",
  "version": "0.5.0",
  "description": "Experimental consent-controlled Meet caption data-channel reader. Prepare before joining; no Tactiq or audio recording.",
  "minimum_chrome_version": "125",
  "devtools_page": "devtools.html",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["meet-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43821; base-uri 'none';"
  }
}
